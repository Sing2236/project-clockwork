# Compiled asset artifacts - s&box regenerates these from the sources on open.
*.vmat_c
*.vtex_c
*.scene_c
*.vmdl_c
*.vsnd_c
*.vpcf_c
*.vmap_c
*.vsmart_c
*.shader_c
*.clothing_c
*.item_c
*.faction_c

# Build output
bin/
obj/

# Editor-generated project files (the editor writes these itself)
*.slnx
Code/*.csproj
Editor/*.csproj

# Engine working state. .sbox/project.json is viewport camera and open-scene bookkeeping that
# changes every time you look around - it is not part of the project.
.sbox/

# Junctioned library checkouts - these are links to other repos, never content.
# BSPImport comes from DoctorGurke/sbox-bsp-import (MIT); hexagon from noahsabaj/hexagon.
Libraries/BSPImport/
Libraries/hexagon/

# OS / editor noise
Thumbs.db
.DS_Store
*.user
